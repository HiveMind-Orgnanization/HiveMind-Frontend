# Same-origin requests → Vite proxies /api and /health to BACKEND_PROXY_TARGET (see vite.config.ts).
VITE_API_URL=

# Backend for dev proxy only (not exposed to the browser bundle).
BACKEND_PROXY_TARGET=http://127.0.0.1:8787
# To proxy to the deployed AWS EB backend instead of a local server:
# BACKEND_PROXY_TARGET=http://hivemind-backend-prod.eba-2pwjk2c2.ap-south-1.elasticbeanstalk.com
