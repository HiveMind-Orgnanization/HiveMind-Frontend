{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://hivemind-backend-prod.eba-2pwjk2c2.ap-south-1.elasticbeanstalk.com/api/:path*" },
    { "source": "/health",     "destination": "http://hivemind-backend-prod.eba-2pwjk2c2.ap-south-1.elasticbeanstalk.com/health" },
    { "source": "/preview/:path*", "destination": "http://hivemind-backend-prod.eba-2pwjk2c2.ap-south-1.elasticbeanstalk.com/preview/:path*" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
